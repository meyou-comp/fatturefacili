# ──── Database ─────────────────────────────────────
DATABASE_URL="postgresql://fatturazioneit:dev_password@localhost:5432/fatturazioneit?schema=public"

# ──── Redis ────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ──── JWT ──────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-a-random-64-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ──── API Server ───────────────────────────────────
API_PORT=3001
API_HOST="0.0.0.0"
API_CORS_ORIGIN="http://localhost:3000"

# ──── Frontend ─────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="FatturazioneIT"

# ──── S3 / MinIO ───────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="fatturazioneit"
S3_REGION="us-east-1"

# ──── Email (SMTP) ─────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@fatturazioneit.it"

